{
  "id": null,
  "uid": "tradesphere-infra",
  "title": "TradeSphere — Infrastructure Dashboard",
  "description": "Cluster resources, pod CPU/memory utilization, pod restart counts, HTTP throughput & latency",
  "tags": ["tradesphere", "infrastructure", "kubernetes"],
  "timezone": "browser",
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Pod CPU Usage (Cores)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "sum(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{namespace=\"tradesphere\"}) by (pod)",
          "legendFormat": "{{ pod }}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Pod Memory Usage (Bytes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"tradesphere\", container!=\"\"}) by (pod)",
          "legendFormat": "{{ pod }}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pod Restarts (Last 1 Hour)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "yellow" },
              { "value": 5, "color": "red" }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"tradesphere\"}[1h])) by (pod)",
          "legendFormat": "{{ pod }}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Pod Status (Ready vs Not Ready)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_ready{namespace=\"tradesphere\", condition=\"true\"})",
          "legendFormat": "Ready Pods"
        },
        {
          "expr": "sum(kube_pod_status_ready{namespace=\"tradesphere\", condition=\"false\"})",
          "legendFormat": "Not Ready Pods"
        }
      ]
    }
  ],
  "schemaVersion": 36,
  "version": 1
}
